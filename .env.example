# Ayanami reads secrets from this file.
# In development, copy it to `.env` in the project folder.
# In an installed copy, save it as `%APPDATA%\ayanami\.env` and restart Ayanami.
# Missing keys are supported: Ayanami falls back to built-in demo metadata.

# SteamGridDB — https://www.steamgriddb.com/profile/preferences/api
STEAMGRIDDB_API_KEY=

# IGDB (Twitch developer application)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Google Drive OAuth (cloud saves)
# Create an OAuth client of type "Desktop app" in Google Cloud and enable the
# Google Drive API. Desktop app clients accept Ayanami's local loopback redirect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
